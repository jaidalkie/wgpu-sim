use wgpu::util::DeviceExt;
use std::sync::Arc;
use bytemuck::{Pod, Zeroable};
use std::time::Instant;
use winit::keyboard::PhysicalKey;
use winit::keyboard::KeyCode;
use std::collections::HashSet;
use std::cmp::max;
use winit::{
    event::*,
    event_loop::{ControlFlow, EventLoop},
    window::WindowBuilder,
};
#[derive(Default)]
struct Input {
    keys_held: HashSet<KeyCode>,
}
fn main() {
    println!("Hello, world!");
    pollster::block_on(run());
}

async fn run() {
    let mut speed: f32 = 1.0f32;
    let padSizeOne: f32 = 0.0f32;
    let padSizeTwo = [0.0f32, 0.0f32];
    let mut player_pos = [0.0f32, 0.0f32, 0.0f32];
    let mut player_angle = [0.0f32, 0.0f32];
    let mut key_down: u32 = 0;
    let mut key_index: u32 = 0;
    let mut mouse_pos = [0.0f32, 0.0f32];
    let mut mouse_down = 0u32;
    let start = Instant::now();
    let mut last = start;
    let mut now = Instant::now();
    let event_loop = EventLoop::new().unwrap();
    let pi = 3.14159265359;

    let mut input = Input {
        keys_held: HashSet::new(),
    };
    let window = Arc::new(
        WindowBuilder::new()
        .with_title("wgpu shader text")
        .build(&event_loop)
        .unwrap()
    );
    // initualise gpu
    let instance = wgpu::Instance::default();
    //let surface = instance.create_surface(&window).unwrap();
    let surface = instance.create_surface(window.as_ref()).unwrap();

    let adapter = instance
        .request_adapter(&wgpu::RequestAdapterOptions {
            compatible_surface: Some(&surface),
            ..Default::default()
        }).await.unwrap();

    let (device, queue) = adapter.request_device(
            &wgpu::DeviceDescriptor {
                label: None,
                required_features: wgpu::Features::empty(),
                required_limits: wgpu::Limits::default(),
            },
            None,
        ).await.unwrap();

    // configure the surface

    let size = window.inner_size();
    let surface_format = surface.get_capabilities(&adapter).formats[0];
    let sim_format = wgpu::TextureFormat::Rgba32Float;

    surface.configure(
        &device,
        &wgpu::SurfaceConfiguration {
            usage: wgpu::TextureUsages::RENDER_ATTACHMENT, 
            format: surface_format,
            width: size.width,
            height: size.height,
            present_mode: wgpu::PresentMode::Fifo,
            desired_maximum_frame_latency: 2,
            alpha_mode: wgpu::CompositeAlphaMode::Auto,
            view_formats: vec![],
        },
    );

    // main loop
    // create sim
    let sim_texture = device.create_texture(&wgpu::TextureDescriptor { // create storage texture
        label: Some("Simulation Texture"),
        size: wgpu::Extent3d {
            width: size.width,
            height: size.height,
            depth_or_array_layers: 1,
        },
        mip_level_count: 1,
        sample_count: 1,
        dimension: wgpu::TextureDimension::D2,
        //format: sim_format,
        format: sim_format,
        usage: wgpu::TextureUsages::STORAGE_BINDING | wgpu::TextureUsages::TEXTURE_BINDING,
        view_formats: &[],
    });
    // create simParams via binding
    #[repr(C)]
    #[derive(Copy, Clone, Pod, Zeroable)]
    struct SimParams {
        size: [u32; 2],
        seconds: f32,
        keyDown: u32,
        mouse: [f32; 2],
        mouse_down: u32,
        keyIndex: u32,
    }
    let params = SimParams {
        size: [size.width, size.height],
        seconds: now.duration_since(start).as_secs_f32(),
        keyDown: key_down,// todo
        mouse: mouse_pos,
        mouse_down: mouse_down,
        keyIndex: key_index,// todo
    };
    let params_buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
        label: Some("Params Buffer"),
        contents: bytemuck::bytes_of(&params),
        usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
    });
     // create simPersist via binding
    #[repr(C)]
    #[derive(Copy, Clone, Pod, Zeroable)]
    struct SimPersist {
        playerPos: [f32; 3], 
        padOne: f32,
        playerAngle: [f32; 2], 
        padTwo: [f32; 2],
    }
    let persist = SimPersist {
        playerPos: player_pos,
        padOne: padSizeOne,
        playerAngle: player_angle,
        padTwo: padSizeTwo,
    };
    let persist_buffer = device.create_buffer_init(&wgpu::util::BufferInitDescriptor {
        label: Some("simPersist Buffer"),
        contents: bytemuck::bytes_of(&persist),
        usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
    });
    // creating a bind group
    let sim_texture_view = sim_texture.create_view(&Default::default());
    let bind_group_layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
        entries: &[
            wgpu::BindGroupLayoutEntry {
                binding: 0,
                visibility: wgpu::ShaderStages::COMPUTE,
                ty: wgpu::BindingType::StorageTexture {
                    access: wgpu::StorageTextureAccess::WriteOnly,
                    format: sim_format,
                    view_dimension: wgpu::TextureViewDimension::D2,
                },
                count: None,
            },
            wgpu::BindGroupLayoutEntry {
                binding: 1,
                visibility: wgpu::ShaderStages::COMPUTE,
                ty: wgpu::BindingType::Buffer {
                    ty: wgpu::BufferBindingType::Uniform,
                    has_dynamic_offset: false,
                    min_binding_size: None,
                },
                count: None,
            },
            wgpu::BindGroupLayoutEntry {
                binding: 2,
                visibility: wgpu::ShaderStages::COMPUTE,
                ty: wgpu::BindingType::Buffer {
                    ty: wgpu::BufferBindingType::Storage { read_only: false},
                    has_dynamic_offset: false,
                    min_binding_size: None,
                },
                count: None,
            },
        ],
        label: Some("compute bgl"),
    });

    let bind_group = device.create_bind_group(&wgpu::BindGroupDescriptor {
        layout: &bind_group_layout,
        entries: &[
            wgpu::BindGroupEntry {
                binding: 0,
                resource: wgpu::BindingResource::TextureView(&sim_texture_view),
            },
            wgpu::BindGroupEntry {
                binding: 1,
                resource: params_buffer.as_entire_binding(),
            },
            wgpu::BindGroupEntry {
                binding: 2,
                resource: persist_buffer.as_entire_binding(),
            },
        ],
        label: Some("compute bg"),
    });

    // create compute pipeline
    let compute_shader = device.create_shader_module(wgpu::include_wgsl!("ShaderComp.wgsl")); // path to shader
    let compute_pipeline = device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
        label: Some("compute pipeline"),
        layout: Some(&device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
            label: Some("compute pipeline layout"),
            bind_group_layouts: &[&bind_group_layout],
            push_constant_ranges: &[],
        })),
        module: &compute_shader,
        entry_point: "cs_main",
        compilation_options: Default::default(),
    });
    // render bind group
    let texture_sampler = device.create_sampler(&wgpu::SamplerDescriptor {
        label: Some("nearest sampler"),
        mag_filter: wgpu::FilterMode::Nearest,
        min_filter: wgpu::FilterMode::Nearest,
        ..Default::default()
    });

    let render_bgl = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
        label: Some("render bgl"),
        entries: &[
            // texture
            wgpu::BindGroupLayoutEntry {
                binding: 0,
                visibility: wgpu::ShaderStages::FRAGMENT,
                ty: wgpu::BindingType::Texture {
                    sample_type: wgpu::TextureSampleType::Float { filterable: false },
                    view_dimension: wgpu::TextureViewDimension::D2,
                    multisampled: false,
                },
                count: None,
            },
            // sampler
            wgpu::BindGroupLayoutEntry {
                binding: 1,
                visibility: wgpu::ShaderStages::FRAGMENT,
                ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::NonFiltering),
                count: None,
            },
            // sampler
            wgpu::BindGroupLayoutEntry {
                binding: 2,
                visibility: wgpu::ShaderStages::FRAGMENT,
                ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::NonFiltering),
                count: None,
            },
        ],
    });

    let render_bg = device.create_bind_group(&wgpu::BindGroupDescriptor {
        label: Some("render bg"),
        layout: &render_bgl,
        entries: &[
            wgpu::BindGroupEntry {
                binding: 0,
                resource: wgpu::BindingResource::TextureView(&sim_texture_view),
            },
            wgpu::BindGroupEntry {
                binding: 1,
                resource: wgpu::BindingResource::Sampler(&texture_sampler),
            },
            wgpu::BindGroupEntry {
                binding: 2,
                resource: wgpu::BindingResource::Sampler(&texture_sampler),
            },
        ],
    });
    // create render pipeline

    let render_shader = device.create_shader_module(wgpu::include_wgsl!("blit.wgsl"));

    let render_pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
        label: Some("render pipeline layout"),
        bind_group_layouts: &[&render_bgl],
        push_constant_ranges: &[],
    });

    let render_pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
        label: Some("blit pipeline"),
        layout: Some(&render_pipeline_layout),
        vertex: wgpu::VertexState {
            module: &render_shader,
            entry_point: "vs_main",
            buffers: &[],
            compilation_options: Default::default(),
        },
        fragment: Some(wgpu::FragmentState {
            module: &render_shader,
            entry_point: "fs_main",
            targets: &[Some(wgpu::ColorTargetState {
                format: surface_format,
                blend: None,
                write_mask: wgpu::ColorWrites::ALL,
            })],
            compilation_options: Default::default(),
        }),
        primitive: wgpu::PrimitiveState::default(),
        depth_stencil: None,
        multisample: wgpu::MultisampleState::default(),
        multiview: None,
    });

    // event loop
    let window_cloned = window.clone();
    event_loop.set_control_flow(winit::event_loop::ControlFlow::Poll); // ensure things run constantly and not while non idle
    event_loop.run(move |event, elwt| {
        match event {
            Event::WindowEvent { event: WindowEvent::KeyboardInput { device_id, event, is_synthetic}, .. } => {
                match event.physical_key {
                    PhysicalKey::Code(keycode) => {
                        match event.state {
                            winit::event::ElementState::Pressed => {
                                input.keys_held.insert(keycode);
                            }
                            winit::event::ElementState::Released => {
                                input.keys_held.remove(&keycode);
                            }
                        }
                    }
                    PhysicalKey::Unidentified(_) => {}
                }
/*                 if let Some(keycode) = event.physical_key.as_key_code() {
                    
                    match event.state {
                        winit::event::ElementState::Pressed => {
                            input.keys_held.insert(keycode);
                        }
                        winit::event::ElementState::Released => {
                            input.keys_held.remove(&keycode);
                        }
                    }
                } */
            }

/*                         if let PhysicalKey::Code(code) = event.physical_key {
                            key_index = code as u32;
                            match code {
                                KeyCode::KeyW => {
                                    player_pos[0] += player_angle[1].cos()*player_angle[0].cos();
                                    player_pos[1] += player_angle[1].sin();
                                    player_pos[2] += player_angle[1].cos()*player_angle[0].sin();
                                }
                                KeyCode::KeyS => {
                                    player_pos[0] -= player_angle[1].cos()*player_angle[0].cos();
                                    player_pos[1] -= player_angle[1].sin();
                                    player_pos[2] -= player_angle[1].cos()*player_angle[0].sin();
                                }
                                KeyCode::ArrowRight => {
                                    player_angle[0] -= 0.1;
                                }
                                KeyCode::ArrowLeft => {
                                    player_angle[0] += 0.1;
                                }
                                KeyCode::ArrowUp => {
                                    player_angle[1] += 0.1;
                                }
                                KeyCode::ArrowDown => {
                                    player_angle[1] -= 0.1;
                                },
                                _=> {}
                            }
                        } */
            Event::WindowEvent { event: WindowEvent::CursorMoved { device_id , position }, .. } => {
                mouse_pos[0] = position.x as f32;
                mouse_pos[1] = position.y as f32;
            }
            
            Event::WindowEvent { event: WindowEvent::MouseInput { state, button: MouseButton::Left, .. }, .. } => {
                mouse_down = if state == ElementState::Pressed { 1 } else { 0 };
            }

            Event::WindowEvent { event: WindowEvent::CloseRequested, .. } => {
                elwt.exit();
            }

            Event::WindowEvent { event: WindowEvent::Resized(new_size), .. } => {
                surface.configure(
                    &device,
                    &wgpu::SurfaceConfiguration {
                        usage: wgpu::TextureUsages::RENDER_ATTACHMENT, 
                        format: surface_format,
                        width: new_size.width,
                        height: new_size.height,
                        present_mode: wgpu::PresentMode::Fifo,
                        desired_maximum_frame_latency: 2,
                        alpha_mode: wgpu::CompositeAlphaMode::Auto,
                        view_formats: vec![],
                    },
                );
            }

            Event::AboutToWait => {
                now = Instant::now();

                if input.keys_held.contains(&KeyCode::KeyW) {
                    player_pos[0] += player_angle[1].cos()*player_angle[0].cos()*speed;
                    player_pos[1] += player_angle[1].sin()*speed;
                    player_pos[2] += player_angle[1].cos()*player_angle[0].sin()*speed;
                }
                if input.keys_held.contains(&KeyCode::KeyS) {
                    player_pos[0] -= player_angle[1].cos()*player_angle[0].cos()*speed;
                    player_pos[1] -= player_angle[1].sin()*speed;
                    player_pos[2] -= player_angle[1].cos()*player_angle[0].sin()*speed;
                }
                if input.keys_held.contains(&KeyCode::KeyA) {
                    player_pos[0] -= (player_angle[0]-pi*0.5).cos()*speed;
                    player_pos[2] -= (player_angle[0]-pi*0.5).sin()*speed;
                }
                if input.keys_held.contains(&KeyCode::KeyD) {
                    player_pos[0] += (player_angle[0]-pi*0.5).cos()*speed;
                    player_pos[2] += (player_angle[0]-pi*0.5).sin()*speed;
                }
                if input.keys_held.contains(&KeyCode::ArrowRight) {
                    player_angle[0] -= 0.07;
                }
                if input.keys_held.contains(&KeyCode::ArrowLeft) {
                    player_angle[0] += 0.07;
                }
                if input.keys_held.contains(&KeyCode::ArrowUp) {
                    player_angle[1] += 0.07;
                }
                if input.keys_held.contains(&KeyCode::ArrowDown) {
                    player_angle[1] -= 0.07;
                }
                if input.keys_held.contains(&KeyCode::KeyQ) {
                    speed += 0.3;
                    if (speed < 0.0) {
                        speed = 0.0;
                    }
                }
                if input.keys_held.contains(&KeyCode::KeyE) {
                    speed -= 0.3;
                    if (speed < 0.0) {
                        speed = 0.0;
                    }
                }

                let params = SimParams {
                    size: [size.width, size.height],
                    seconds: now.duration_since(start).as_secs_f32(),
                    keyDown: key_down,// todo
                    mouse: mouse_pos,
                    mouse_down: mouse_down,
                    keyIndex: key_index,// todo
                };
                let persist = SimPersist {
                    playerPos: player_pos,
                    padOne: padSizeOne,
                    playerAngle: player_angle,
                    padTwo: padSizeTwo,
                };
                last = now;
                queue.write_buffer(
                    &params_buffer,
                    0,
                    bytemuck::bytes_of(&params),
                );
                queue.write_buffer(
                    &persist_buffer,
                    0,
                    bytemuck::bytes_of(&persist),
                );

                let mut encoder = device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("frame encoder") });
                {
                    let mut cpass = encoder.begin_compute_pass(&wgpu::ComputePassDescriptor { 
                        label: Some("compute pass"),
                        timestamp_writes: None,
                    });
                    cpass.set_pipeline(&compute_pipeline);
                    cpass.set_bind_group(0, &bind_group, &[]);
                    cpass.dispatch_workgroups(
                        (size.width+7)/8,
                        (size.height+7)/8,
                        1,
                    );
                }


                let frame = match surface.get_current_texture() {
                    Ok(frame) => frame,
                    Err(_) => {
                        let size = window_cloned.inner_size();
                        surface.configure(
                            &device,
                            &wgpu::SurfaceConfiguration {
                                usage: wgpu::TextureUsages::RENDER_ATTACHMENT, 
                                format: surface_format,
                                width: size.width,
                                height: size.height,
                                present_mode: wgpu::PresentMode::Fifo,
                                desired_maximum_frame_latency: 2,
                                alpha_mode: wgpu::CompositeAlphaMode::Auto,
                                view_formats: vec![],
                            },
                        );
                        return;
                    }
                };

                let view = frame.texture.create_view(&wgpu::TextureViewDescriptor::default());
                {
                    let mut rpass = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
                        label: Some("Render Pass"),
                        color_attachments: &[Some(wgpu::RenderPassColorAttachment {
                            view: &view,
                            resolve_target: None,
                            ops: wgpu::Operations {
                                load: wgpu::LoadOp::Clear(wgpu::Color::BLACK),
                                store: wgpu::StoreOp::Store,
                            },
                        })],
                        depth_stencil_attachment: None,
                        occlusion_query_set: None,
                        timestamp_writes: None,
                    });

                    rpass.set_pipeline(&render_pipeline);
                    rpass.set_bind_group(0, &render_bg, &[]);
                    rpass.draw(0..6,0..1);
                }
                
                queue.submit(Some(encoder.finish()));
                frame.present();
            }

            _=> {}
        }
    }).unwrap();
}
// hashing // -----------------------------------------------------------------------------------------------------------------

fn DDHasher(number: vec2<f32>) -> f32 {
    let number2 = (1./4320.0)*(number)+vec2<f32>(0.25,0.); 
    let state = fract(dot(number2*number2,vec2<f32>(3571)));
    return fract(state*state*(3571.*2.));
}
fn DDDHasher(number: vec3<f32>) -> f32 {
    var number2 = fract(number*.1033);
    number2 = number2 + (dot(number2,number2.yzx + 33.33));
    return fract((number2.x + number2.y)*number2.z);
}
fn DDHashVec(coords: vec2<f32>) -> vec2<f32> {
    let hashed = DDHasher(coords)*2*pi;
    return normalize(vec2<f32>(cos(hashed),sin(hashed)));
}
fn DDDHashVec(coords: vec3<f32>) -> vec3<f32> { // may have artifacts in its hashing function
    var number2 = fract(coords*vec3<f32>(.1031, .1030, .0973));
    number2 = number2 + dot(number2, number2.yzx+33.33);
    let hashed = fract((number2.xx+number2.yz)*number2.zy)*2*pi;

    return normalize(vec3<f32>(
    cos(hashed.y)*cos(hashed.x),
    sin(hashed.y),
    cos(hashed.y)*sin(hashed.x)
    ));
}
fn DDHash(coords: vec2<f32>) -> vec2<f32> {
    let res = 100.0;
    let hashed = floor(DDHasher(coords)*(res*res));
    let x = f32((hashed%res)/res);
    let y = f32(floor(hashed/res)/res);
    return vec2<f32>(x,y);
}
fn DDDHash(coords: vec3<f32>) -> vec3<f32> {
    let res = 100.0;
    let hashed = floor(DDDHasher(coords)*(res*res*res));
    let x = hashed%res;
    let y = floor(hashed/res)%(res);
    let z = floor(hashed/(res*res));
    return vec3<f32>(f32(x/res),f32(y/res),f32(z/res));
}

// components // -----------------------------------------------------------------------------------------------------------------

fn DDDistance(one: vec2<f32>, two: vec2<f32>) -> f32 {
    let dx = one.x-two.x;
    let dy = one.y-two.y;
    return sqrt(dx*dx+dy*dy);
}
fn DDDDistance(one: vec3<f32>, two: vec3<f32>) -> f32 {
    let dx = one.x-two.x;
    let dy = one.y-two.y;
    let dz = one.z-two.z;
    return sqrt(dx*dx+dy*dy+dz*dz);
}

// noise // -----------------------------------------------------------------------------------------------------------------

fn setVec4(v: vec4<f32>, idx: u32, value: f32) -> vec4<f32> {
    var r = v;
    switch idx {
        case 0u: { r.x = value; }
        case 1u: { r.y = value; }
        case 2u: { r.z = value; }
        case 3u: { r.w = value; }
        default {}
    }
    return r;
}
fn octoDot(qO: vec3<f32>, qC: vec3<f32>) -> vector8 {
    let pos = qC+qO;
    var octoDot : vector8;
    octoDot.a = vec4<f32>(0.0);
    octoDot.b = vec4<f32>(0.0);
    var counter : u32 = 0u;
    for (var y:f32=0;y<2.0;y=y+1.0) {
        for (var x:f32=0;x<2.0;x=x+1.0) {
            let qPos = vec3<f32>(x,y,0);
            let qVec = DDDHashVec(qPos+qO);
            octoDot.a = setVec4(
                octoDot.a,
                counter,
                dot(qVec, qC-qPos)
            );
            counter = counter + 1;
        }
    }
    counter = 0u;
    for (var y:f32=0;y<2.0;y=y+1.0) {
        for (var x:f32=0;x<2.0;x=x+1.0) {
            let qPos = vec3<f32>(x,y,1);
            let qVec = DDDHashVec(qPos+qO);
            octoDot.b = setVec4(
                octoDot.b,
                counter,
                dot(qVec, qC-qPos)
            );
            counter = counter + 1;
        }
    }
    return octoDot;
}
fn quadDot(qO: vec2<f32>, qC: vec2<f32>) -> vec4<f32> {
    var quadDot = vec4<f32>(0.0);
    var counter : u32 = 0u;
    for (var y:f32=0;y<2.0;y=y+1.0) {
        for (var x:f32=0;x<2.0;x=x+1.0) {
            let qPos = vec2<f32>(x,y);
            let qVec = DDHashVec(qPos+qO);
            quadDot[counter] = dot(qVec, qC-qPos);
            counter = counter + 1;
        }
    }
    return quadDot;
}
fn linTerp(ratio: f32, one: f32, two: f32) -> f32 {
    return one+(ratio)*(two-one);
}
fn fade(weight: f32) -> f32 {
    return weight*weight*weight*(weight*(weight*6.0-15.0)+10.0);
}
fn quadlerpfaded(qCoord: vec2<f32>, values: vec4<f32>) -> f32 {
    let faded = vec2<f32>(fade(qCoord.x),fade(qCoord.y));
    let one = linTerp(faded.x,values.r,values.g);
    let two = linTerp(faded.x,values.b,values.a);
    return linTerp(faded.y,one,two);
}
fn octolerpfaded(qC: vec3<f32>, values: vector8) -> f32 {
    let faded = fade(qC.z);
    let one = quadlerpfaded(qC.xy,values.a);
    let two = quadlerpfaded(qC.xy,values.b);
    return linTerp(faded,one,two);
}
fn perlin(coord: vec2<f32>) -> f32 {
    let qC = fract(coord);
    let qO = floor(coord);
    return (quadlerpfaded(qC,quadDot(qO,qC))+1)/2;
}
fn DDDperlin(coord: vec3<f32>) -> f32 {
    let qC = fract(coord);
    let qO = floor(coord);
    return (octolerpfaded(qC,octoDot(qO,qC))+1)/2;
}
fn worly(coord: vec2<f32>) -> f32 {
    let qC = fract(coord);
    let qO = floor(coord);

    var minimum = 9999.0;
    let pos = qC+qO;
    for (var x:f32=-1.0;x<2.0;x=x+1.0) {
        for (var y:f32=-1.0;y<2.0;y=y+1.0) {
            let qPos = vec2<f32>(x,y)+qO;
            let hashedQPos = DDHash(qPos)+qPos;
            let dist = DDDistance(pos,hashedQPos);
            if (minimum > dist) {
                minimum = dist;
            }
        }
    }
    return min(minimum,1.0);// could use the real upperbound but it has diminishing returns:  /sqrt(2)
}
fn DDDWorly(coord: vec3<f32>) -> f32 {
    let qC = fract(coord);
    let qO = floor(coord);

    var minimum = 999999.0;
    let pos = qC+qO;
    for (var x:f32=-1.0;x<2.0;x=x+1.0) {
        for (var y:f32=-1.0;y<2.0;y=y+1.0) {
            for (var z:f32=-1.0;z<2.0;z=z+1.0) {
                let qPos = vec3<f32>(x,y,z)+qO;
                let hashedQPos = DDDHash(qPos)+qPos;
                let dist = DDDDistance(pos,hashedQPos);
                if (minimum > dist) {
                    minimum = dist;
                }
            }
        }
    }
    return min(minimum,1.0);// could use the real upperbound but it has diminishing returns: /sqrt(3);
}
fn DDDboxSDF(cCoord: vec3<f32>, bCoord: vec3<f32>, scale: f32) -> f32 {
    let f = abs((cCoord-bCoord)-scale)-scale;
    return length(max(f,vec3(0.0)))+min(max(f.x,max(f.y,f.z)),0.0);
}
fn worldSDF(coord: vec3<f32>, wPos: vec3<f32>) -> hitInfo { // for getting information about the world based on a point, this is utilised by the marcher for knowing what to do next.
    let qC = fract(coord);
    let qO = floor(coord);

    var hit : hitInfo;
    hit.dist = 1.0; // assumed max travel without overshoot
    hit.normal = vec3<f32>(0.0);
    hit.hit = 0u; // 0: no hit, 1: hit, 2: out of bounds
    hit.density = 0.0;
    let pos = qC+qO;
    //let bgPerlin = DDDperlin(pos*2);

    for (var x:f32=-1.0;x<2.0;x=x+1.0) {
        for (var y:f32=-1.0;y<2.0;y=y+1.0) {
            for (var z:f32=-1.0;z<2.0;z=z+1.0) {
                let lod = floor(length(wPos-coord)/100.0+1.0);
                let qPos = (vec3<f32>(x,y,z)+qO)*lod;
                if (DDDHasher(qPos) > 0.95) {
                    let dist = DDDboxSDF(qC,vec3<f32>(x,y,z), 0.5*lod);
                    if (hit.dist > dist) {
                        hit.dist = dist;
                    }
                }
                if (hit.dist < 0.1) {
                    hit.density = max(-(hit.dist),0.0);
                    hit.normal = -normalize(DDDcenter(qC));
                    hit.hit = 1u;
                    return hit;
                } //else if (hit.dist > 10.0) { // out of bounds, this part is unnessasary but will be implemented.
                //    hit.hit = 2u;
                //}
            }
        }
    }
    return hit;
}
fn testCloud(coord: vec3<f32>) -> hitInfo {
    let qC = fract(coord);
    let qO = floor(coord);

    var hit : hitInfo;
    hit.normal = vec3<f32>(0.0);
    hit.hit = 0u; // 0: no hit, 1: hit, 2: out of bounds
    hit.density = 0.0;

    let pos = qC+qO;
    let bgPerlin = DDDperlin(pos)*2-1;
    hit.dist = DDDDistance(pos,vec3<f32>(0.0))-8.0+bgPerlin*2;
    if (hit.dist < 0.1) {// "0.1" added so that rays can enter the volume faster/ without to many mini marches. but its a tradeoff, the higher the value, the more liklely more unessasary volume marches will become.
        hit.density = max(-hit.dist-1.0,0.0);// "-0.5" padding for rays with inaccurate marches, as a result of added perlin noise.
        hit.normal = -normalize(DDDcenter(pos));
        hit.hit = 1u;
        return hit;
    }
    return hit;
}

// transforms // -----------------------------------------------------------------------------------------------------------------

fn center(coords: vec2<f32>) -> vec2<f32> {
    return (coords*2.0)-vec2<f32>(1.0);
}
fn DDDcenter(coords: vec3<f32>) -> vec3<f32> {
    return (coords*2.0)-vec3<f32>(1.0);
}
fn RX(one: vec3<f32>, theta: f32) -> vec3<f32> {
    let s = sin(theta);
    let c = cos(theta);

    let matrix = mat3x3<f32>(
    vec3<f32>(1.0,0,0),
    vec3<f32>(0,c,-s),
    vec3<f32>(0,s,c)
    );
    return vec3<f32>(matrix*one);
}
fn RY(one: vec3<f32>, theta: f32) -> vec3<f32> {
    let s = sin(theta);
    let c = cos(theta);

    let matrix = mat3x3<f32>(
    vec3<f32>(c,0,s),
    vec3<f32>(0,1.0,0),
    vec3<f32>(-s,0,c)
    );
    return vec3<f32>(matrix*one);
}
fn RZ(one: vec3<f32>, theta: f32) -> vec3<f32> {
    let s = sin(theta);
    let c = cos(theta);

    let matrix = mat3x3<f32>(
    vec3<f32>(c,-s,0,),
    vec3<f32>(s,c,0),
    vec3<f32>(0,0,1.0)
    );
    return vec3<f32>(matrix*one);
}
fn rotate(one: vec3<f32>, two: vec3<f32>) -> vec3<f32> {
    return RZ(RY(RX(one,two[0]),two[1]),two[2]);
}

// lighting // -----------------------------------------------------------------------------------------------------------------

fn BeerLambert(density: f32, dist: f32) -> f32 {
    return exp(-density*dist);
}
fn HenyeyGreensteinn(g: f32, costh: f32) -> f32 {
    return (1.0/(4.0*pi))*
    ((1.0-g*g)/pow(1.0+g*g-2.0*g*costh,1.5));
}
fn BeerLambertPowder(density: f32, dist: f32) -> f32 {
    return exp(-2*(density*dist))+exp(-(density*dist));
}
fn ray(uvVecInit: vec3<f32>, uvPosInit: vec3<f32>, steps: f32, wPos: vec3<f32>) -> rayInfo {
    var uvVec = uvVecInit;
    var uvPos = uvPosInit;
    var lod = 1.0;
    var ray : rayInfo;
    ray.normal = vec3<f32>(0.0);
    ray.uv = vec3<f32>(0.0);
    ray.dist = 0.0;

    
    var fPos = fract(uvPosInit/lod)*lod;
    var qPos = floor(uvPosInit/lod)*lod;
    var vecSign = sign(uvVec)*lod;
    if (uvVec.y == 0) {
        vecSign.y = 0.0001;
    }
    var t = (((vecSign+lod)*0.5)-fPos)/uvVec;

    var tStep = abs(lod/uvVec);
    var qStep = vecSign;
    var hit = vec3<f32>(0.0);
    
    for (var x:f32=0;x<steps;x+=1.0) {
        //if (floor(mod(DDDDistance(t*uvVec+uvPosInit,uvPosInit),100.0)) == 1) {} // lod point, increases the step sizes 
        if (DDDperlin(qPos/30.0) > 0.7) {
        //if (DDDHasher(round(qPos)) > 0.9) {
            //ray.dist = DDDDistance(t*uvVec+uvPosInit,uvPosInit)/200.0;
            ray.dist = min(t.x,min(t.y,t.z));
            return ray;
        }
        ray.normal = vec3<f32>(0.0);

        if (t.x<=t.y && t.x<=t.z) {
            hit = uvVec*t.x+uvPosInit;
            ray.uv = vec3<f32>((hit-floor(hit)).zy,0.0);//xy
            ray.normal.x = -qStep.x;

            qPos.x += qStep.x;
            t.x += tStep.x;
        } else if (t.y<=t.z) {
            hit = uvVec*t.y+uvPosInit;
            ray.uv = vec3<f32>((hit-floor(hit)).xz,0.0);//xz
            ray.normal.y = -qStep.y;

            qPos.y += qStep.y;
            t.y += tStep.y;
        } else {
            hit = uvVec*t.z+uvPosInit;
            ray.uv = vec3<f32>((hit-floor(hit)).xy,0.0);//zy
            ray.normal.z = -qStep.z;

            qPos.z += qStep.z;
            t.z += tStep.z;
        }

    }
    ray.normal = uvVec;
    ray.uv = uvVec;
    return ray;
}

@compute @workgroup_size(8,8)
fn cs_main(@builtin(global_invocation_id) id: vec3<u32>) {
    //let size = textureDimentions(outputTex);
    let size = params.size;
    //let index = id.y*size.x+id.x;
    let fSize = vec2<f32>(f32(size.x),f32(size.y));
    let coord = vec2<f32>(f32(id.x)/fSize.x, f32(id.y)/fSize.y);
    let nMouse = params.mouse/fSize;
    let uv = center(coord);
    let downsample = f32(1.0/100.0);

    let wPos = vec3<f32>(params.seconds*0.5,params.seconds*0.5+0.5,params.seconds*0.5);
    //let wPos = vec3<f32>(cos(params.seconds*0.5)*16,0,sin(params.seconds*0.5)*16);
    let fov : f32 = 1.0;
    //let uvRot = rotate(vec3<f32>(uv,fov),vec3<f32>(0,params.seconds*0.2+pi/2,0));
    let uvRot = rotate(vec3<f32>(uv,fov),vec3<f32>(nMouse.y*3.0-1.5,nMouse.x*3.0,0));
    let uvVec = normalize(uvRot);
    var uvPos = wPos;

    if (id.x >= size.x || id.y >= size.y) { // cull coords outside screenspace.
        return;
    }

    let ray = ray(uvVec, uvPos, 200.0, wPos);
    var value = vec3<f32>(ray.normal);
    
    let color = vec4<f32>(value, 1.0);
    textureStore(outputTex, id.xy, color);
}
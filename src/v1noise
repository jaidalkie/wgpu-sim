fn center(coords: vec2<f32>) -> vec2<f32> {
    return (coords*2.0)-vec2<f32>(1.0);
}

fn hash(number: vec2<f32>) -> f32 {
    let number2 = (1./4320.0)*(round(number)*1234.0)+vec2<f32>(0.25,0.); // *1234.0, gets the hash to function properly considering its issues with small numbers
    let state = fract(dot(number2*number2,vec2<f32>(3571)));
    return fract(state*state*(3571.*2.));
}

fn DDHashVec(coords: vec2<f32>) -> vec2<f32> {
    let hashed = hash(coords)*2*pi;
    return normalize(vec2<f32>(cos(hashed),sin(hashed)));
}

fn quadDot(coords: vec2<f32>, qCoord: vec2<f32>) -> vec4<f32> {
    let one = vec2<f32>(0,0)+coords;
    let two = vec2<f32>(1,0)+coords;
    let three = vec2<f32>(0,1)+coords;
    let four = vec2<f32>(1,1)+coords;

    let oneVec = dot(DDHashVec(one), (qCoord-vec2<f32>(0,0)));
    let twoVec = dot(DDHashVec(two), (qCoord-vec2<f32>(1,0)));
    let threeVec = dot(DDHashVec(three), (qCoord-vec2<f32>(0,1)));
    let fourVec = dot(DDHashVec(four), (qCoord-vec2<f32>(1,1)));
    return vec4<f32>(oneVec,twoVec,threeVec,fourVec);
}

fn linTerp(ratio: f32, one: f32, two: f32) -> f32 {
    //return (one*ratio)+(two*(1-ratio));
    return one+(-2*(ratio*ratio*ratio)+3*(ratio*ratio))*(two-one);
    //return one+(ratio)*(two-one);
    //return ratio*(one+two)-two;
}

fn fade(weight: f32) -> f32 {
    return weight*weight*weight*(weight*(weight*6.0-15.0)+10.0);
}

fn quadlerpfaded(qCoord: vec2<f32>, values: vec4<f32>) -> f32 {
    let faded = vec2<f32>(fade(qCoord.x),fade(qCoord.y));
    let one = linTerp(faded.x,values.r,values.g);
    let two = linTerp(faded.x,values.b,values.a);
    //return linTerp(faded.y,one,two);
    return linTerp(faded.y,one,two);
}

fn quadlerp(qCoord: vec2<f32>, values: vec4<f32>) -> f32 {
    let one = linTerp(qCoord.x,values.r,values.g);
    let two = linTerp(qCoord.x,values.b,values.a);
    return linTerp(qCoord.y,one,two);
}

fn perlin(coord: vec2<f32>) -> f32 {
    let quadrantCoord = fract(coord);
    let quadrantOrigin = floor(coord);
    return quadlerpfaded(quadrantCoord,quadDot(quadrantOrigin,quadrantCoord));
    //return quadlerp(quadrantCoord,quadDot(quadrantOrigin,quadrantCoord));
}

